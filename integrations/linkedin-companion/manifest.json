{
  "manifest_version": 3,
  "name": "JobSmart LinkedIn Companion",
  "version": "0.1.0",
  "description": "Review approved JobSmart materials and fill supported LinkedIn form fields. Never submits an application.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*", "https://*.linkedin.com/*", "http://localhost:3004/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "JobSmart Companion" },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/jobs/*", "https://*.linkedin.com/jobs/*", "https://www.linkedin.com/in/*", "https://*.linkedin.com/in/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
